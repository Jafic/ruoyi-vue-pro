#!groovy
/**
 * ruoyi-vue-pro 传统部署流水线：
 * 检出 → 后端 Maven 构建 → 前端 pnpm 构建 → 后端 deploy.sh → 前端同步到 Nginx 目录
 *
 * 前置：Agent 已安装 JDK17、Maven、Node/pnpm；部署目录可写；Apollo/MySQL/Redis 可达。
 * Nginx 站点配置为一次性准备，见 script/nginx/yudao-admin.conf
 */
pipeline {
    agent any

    parameters {
        string(name: 'GIT_URL', defaultValue: 'https://gitee.com/will-we/ruoyi-vue-pro.git', description: 'Git 仓库地址')
        string(name: 'GIT_BRANCH', defaultValue: 'master', description: '分支名')
        choice(name: 'DEPLOY_SCOPE', choices: ['all', 'backend', 'frontend'], description: '部署范围')
        string(name: 'APOLLO_META', defaultValue: 'http://127.0.0.1:8080', description: 'Apollo Meta Server 地址')
        string(name: 'APOLLO_ENV', defaultValue: 'DEV', description: 'Apollo 环境：DEV / UAT / PRO')
        string(name: 'VITE_BASE_URL', defaultValue: '', description: '可选：覆盖前端 .env.prod 的 VITE_BASE_URL，如 http://192.168.1.10')
    }

    environment {
        APP_NAME = 'yudao-server'
        APP_DEPLOY_BASE_DIR = '/work/projects/'
        UI_DEPLOY_DIR = '/work/projects/yudao-ui-admin'
        UI_MODULE_DIR = 'yudao-ui/yudao-ui-admin-vue3'
        PROFILES_ACTIVE = 'local'
        HEALTH_CHECK_URL = 'http://127.0.0.1:48080/actuator/health/'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('检出') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[url: "${params.GIT_URL}"]]
                ])
            }
        }

        stage('构建后端') {
            when {
                expression { params.DEPLOY_SCOPE == 'all' || params.DEPLOY_SCOPE == 'backend' }
            }
            steps {
                sh 'mvn clean package -Dmaven.test.skip=true'
                archiveArtifacts artifacts: "${env.APP_NAME}/target/*.jar", fingerprint: true
            }
        }

        stage('构建前端') {
            when {
                expression { params.DEPLOY_SCOPE == 'all' || params.DEPLOY_SCOPE == 'frontend' }
            }
            steps {
                dir("${env.UI_MODULE_DIR}") {
                    script {
                        if (params.VITE_BASE_URL?.trim()) {
                            sh """
                                if grep -q '^VITE_BASE_URL=' .env.prod; then
                                  sed -i "s|^VITE_BASE_URL=.*|VITE_BASE_URL='${params.VITE_BASE_URL}'|" .env.prod
                                else
                                  echo "VITE_BASE_URL='${params.VITE_BASE_URL}'" >> .env.prod
                                fi
                            """
                        }
                    }
                    sh '''
                        pnpm i --frozen-lockfile || pnpm i
                        pnpm build:prod
                    '''
                }
            }
        }

        stage('部署后端') {
            when {
                expression { params.DEPLOY_SCOPE == 'all' || params.DEPLOY_SCOPE == 'backend' }
            }
            steps {
                sh """
                    mkdir -p ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/build
                    cp -f script/shell/deploy.sh ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/
                    cp -f ${env.APP_NAME}/target/*.jar ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/build/
                    # 统一运行包名为 yudao-server.jar
                    cd ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/build
                    JAR_FILE=\$(ls -t *.jar | head -n 1)
                    if [ "\$JAR_FILE" != "yudao-server.jar" ]; then
                      cp -f "\$JAR_FILE" yudao-server.jar
                    fi
                    chmod +x ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/deploy.sh
                    export APOLLO_META='${params.APOLLO_META}'
                    export APOLLO_ENV='${params.APOLLO_ENV}'
                    export PROFILES_ACTIVE='${env.PROFILES_ACTIVE}'
                    export HEALTH_CHECK_URL='${env.HEALTH_CHECK_URL}'
                    export BASE_PATH='${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}'
                    bash ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/deploy.sh
                """
            }
        }

        stage('部署前端') {
            when {
                expression { params.DEPLOY_SCOPE == 'all' || params.DEPLOY_SCOPE == 'frontend' }
            }
            steps {
                sh """
                    mkdir -p ${env.UI_DEPLOY_DIR}
                    if command -v rsync >/dev/null 2>&1; then
                      rsync -a --delete ${env.UI_MODULE_DIR}/dist-prod/ ${env.UI_DEPLOY_DIR}/
                    else
                      rm -rf ${env.UI_DEPLOY_DIR}/*
                      cp -r ${env.UI_MODULE_DIR}/dist-prod/* ${env.UI_DEPLOY_DIR}/
                    fi
                    echo "[frontend] 已发布到 ${env.UI_DEPLOY_DIR}"
                """
            }
        }
    }

    post {
        success {
            echo "部署成功。请验证: ${env.HEALTH_CHECK_URL} 与 Nginx 站点"
        }
        failure {
            echo "部署失败。后端日志: ${env.APP_DEPLOY_BASE_DIR}${env.APP_NAME}/logs/nohup.out"
        }
    }
}
